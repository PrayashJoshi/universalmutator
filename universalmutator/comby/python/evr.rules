return :[expr] ==> return 0
return :[expr] ==> return None
return :[expr] ==> return True
return :[expr] ==> return False

:[var] = :[expr] ==> :[var] = 0
:[var] = :[expr] ==> :[var] = None
:[var] = :[expr] ==> :[var] = True
:[var] = :[expr] ==> :[var] = False
:[var] = :[expr] ==> :[var] = []

